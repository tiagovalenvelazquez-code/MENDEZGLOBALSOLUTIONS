# Development only. The loopback PGlite service uses disposable local placeholders.
# For a real PostgreSQL server, replace this URL in your private .env file.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres
APP_URL=http://127.0.0.1:3000
APP_ENV=development
STORAGE_DIR=./private/uploads
DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@mgs-demo.test
# Set a unique password (12+ characters) before seeding. Never commit the actual value.
DEMO_ADMIN_PASSWORD=
LOCAL_PG_PORT=54329
LOCAL_PG_DIR=./data/postgres
SESSION_HOURS=8
MAX_UPLOAD_MB=15
TRUST_PROXY=false
NEXT_TELEMETRY_DISABLED=1

# Optional: a separate, empty real environment (DEMO_DATA=false).
# Leave these blank for the local demonstration. Never commit actual credentials.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional Docker PostgreSQL password. Set only in your private environment.
POSTGRES_PASSWORD=
